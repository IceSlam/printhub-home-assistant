PORT=8080
PUBLIC_URL=https://print.iceslam.ru
WEBAPP_URL=https://print.iceslam.ru/webapp/

# Должен совпадать с агентом
AGENT_TOKEN=replace-with-long-random-token
DEFAULT_AGENT_ID=iceslamprint-xp365b

# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
# РОВНО два Telegram user ID через запятую
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
TELEGRAM_MODE=polling
DEFAULT_COPIES=1
WEBAPP_INITDATA_MAX_AGE=86400

# Кэш списка доступных документов; UI обновляется раз в 30 сек
MARKETPLACE_CACHE_MS=20000

# Ozon Seller API
OZON_ENABLED=true
OZON_CLIENT_ID=
OZON_API_KEY=

# Wildberries API
WB_ENABLED=true
WB_API_TOKEN=

# Яндекс Маркет Partner API
YANDEX_ENABLED=true
YANDEX_API_KEY=
# Можно несколько campaignId через запятую
YANDEX_CAMPAIGN_IDS=

# Агент: эти параметры задаются в docker-compose.agent.yml / .env агента.
# Основной принтер подключён по USB через CUPS.
# Для резервной печати по LAN создайте вторую CUPS-очередь XP365B_IP.
# PRINTER_CONNECTION_MODE=auto
# CUPS_PRINTER_USB=XP365B
# CUPS_PRINTER_IP=XP365B_IP
# PRINTER_HOST=192.168.77.89
# PRINTER_PORT=9100

# Telegram notifications for new marketplace printables
MARKETPLACE_NOTIFY_MS=30000
MARKETPLACE_NOTIFY_INITIAL=false

# Окно поиска доступных FBS-этикеток Ozon по cutoff.
# По умолчанию: 30 дней назад + 30 дней вперёд.
OZON_FBS_CUTOFF_PAST_DAYS=30
OZON_FBS_CUTOFF_FUTURE_DAYS=30

# Максимум страниц Ozon FBS по 100 отправлений
OZON_FBS_MAX_PAGES=50
