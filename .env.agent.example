# Обязателен только AGENT_TOKEN. SERVER_URL/WS_URL имеют безопасные
# значения по умолчанию для текущего PrintHub, но оставлены здесь для явности.
SERVER_URL=https://print.iceslam.ru
WS_URL=wss://print.iceslam.ru/ws/agent
AGENT_TOKEN=PUT_THE_SAME_AGENT_TOKEN_AS_SERVER_HERE
AGENT_ID=iceslamprint-xp365b

# auto = USB CUPS -> IP CUPS fallback; usb = только USB; ip = только IP
PRINTER_CONNECTION_MODE=auto
CUPS_PRINTER_USB=XP365B
CUPS_PRINTER_IP=XP365B_IP
CUPS_SERVER=/run/cups/cups.sock

# CUPS resilience
CUPS_READY_TIMEOUT_MS=20000
CUPS_HEALTH_INTERVAL_MS=15000
CUPS_PRINT_RETRIES=2
CUPS_PRINT_RETRY_DELAY_MS=1500
CUPS_WAIT_FOR_JOB=true
CUPS_JOB_TIMEOUT_MS=60000
CUPS_JOB_POLL_MS=1500

# Optional direct/IP settings
PRINTER_HOST=192.168.77.89
PRINTER_PORT=9100
PRINTER_NAME=XP365B
PDF_PRINT_MODE=cups
PRINT_DPI=203
PDF_DETECT_TOLERANCE_MM=3

# WebSocket resilience
WS_STATUS_INTERVAL_MS=10000
WS_NATIVE_PING_MS=10000
WS_PONG_TIMEOUT_MS=45000
